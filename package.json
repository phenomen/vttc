{
  "name": "vttc",
  "version": "4.1.1",
  "description": "CLI file converter and optimizer for popular media formats. Requires Bun.",
  "repository": "phenomen/vttc",
  "author": "phenomen",
  "license": "MIT",
  "scripts": {
    "start": "bun src/index.ts"
  },
